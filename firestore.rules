rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() in [
          'rhyshowe2023@outlook.com',
          'dhineberry@yahoo.com',
          'test@elitearrows.co.uk'
        ]) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isTournamentAdmin', false) == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isCupAdmin', false) == true
        ))
      );
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isFixtureParticipant(data) {
      return signedIn() && (
        data.get('player1Id', '') == request.auth.uid ||
        data.get('player2Id', '') == request.auth.uid ||
        data.get('player1', '') == request.auth.uid ||
        data.get('player2', '') == request.auth.uid ||
        data.get('createdBy', '') == request.auth.uid
      );
    }

    function participantFixtureUpdateIsSafe() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return !affected.hasAny([
        'player1Id',
        'player2Id',
        'player1',
        'player2',
        'cupId',
        'matchId'
      ]);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if isOwner(userId) || isAdmin();
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['friends', 'sentFriendRequests', 'receivedFriendRequests']);
    }

    match /results/{resultId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /chatMessages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && (isOwner(resource.data.senderId) || isAdmin());
    }

    match /fixtures/{fixtureId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (isAdmin() || (isFixtureParticipant(resource.data) && participantFixtureUpdateIsSafe()));
      allow delete: if signedIn() && (isAdmin() || isFixtureParticipant(resource.data));
    }

    match /cups/{cupId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /tournament_records/{recordId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /adminData/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /supportRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update: if isAdmin();
    }

    match /seasons/{seasonId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (isOwner(resource.data.toUserId) || isAdmin());
      allow write: if signedIn();
    }

    match /fcmTokens/{tokenId} {
      allow read, write: if signedIn() && isOwner(tokenId);
    }

    match /bets/{betId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /tournamentSignups/{signupId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /giveaways/{giveawayId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /challengeSubmissions/{submissionId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /disputes/{disputeId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /openLeagueDuos/{duoId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /openLeagueSingles/{singlesId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
    }

    match /highlights/{highlightId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin() || isOwner(resource.data.userId);
    }

    match /practiceSessions/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /progressLogs/{logId} {
      allow read: if signedIn() && (isOwner(resource.data.userId) || resource.data.get('isPublic', false) == true || isAdmin());
      allow create: if signedIn();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /practiceLeaderboard/{entryId} {
      allow read, create, update: if signedIn();
    }

    match /liveGames/{gameId} {
      allow read, write: if signedIn();
    }

    match /gameInvites/{inviteId} {
      allow read, write: if signedIn();
    }

    // Merch Shop Collections - Public access for submissions
    match /merchPlayerApplications/{appId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }
    match /merchRoleApplications/{appId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }
    match /merchSuggestions/{sugId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    match /mail/{mailId} {
      allow create: if isAdmin();
    }
  }
}
