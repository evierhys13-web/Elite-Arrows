rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() in [
          'rhyshowe2023@outlook.com',
          'dhineberry@yahoo.com',
          'test@elitearrows.co.uk'
        ]) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTournamentAdmin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isCupAdmin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == 'true' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTournamentAdmin == 'true'
        ))
      );
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isFixtureParticipant(data) {
      return signedIn() && (
        data.get('player1Id', '') == request.auth.uid ||
        data.get('player2Id', '') == request.auth.uid ||
        data.get('player1', '') == request.auth.uid ||
        data.get('player2', '') == request.auth.uid ||
        data.get('createdBy', '') == request.auth.uid
      );
    }

    function participantFixtureUpdateIsSafe() {
      // Participants can change status, dates, scores, and set the _deleted flag.
      // We only block changing the core identity of the fixture (who is playing and what match it is).
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return !affected.hasAny([
        'player1Id',
        'player2Id',
        'player1',
        'player2',
        'cupId',
        'matchId'
      ]);
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) || isAdmin();
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['friends', 'sentFriendRequests', 'receivedFriendRequests']);
    }

    match /results/{resultId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /chatMessages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (isOwner(resource.data.senderId) || isAdmin());
      allow delete: if request.auth != null &&
        (isOwner(resource.data.senderId) || isAdmin());
    }

    match /fixtures/{fixtureId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && (
        isAdmin() ||
        resource.data.player1Id == request.auth.uid ||
        resource.data.player2Id == request.auth.uid ||
        resource.data.player1 == request.auth.uid ||
        resource.data.player2 == request.auth.uid ||
        resource.data.createdBy == request.auth.uid
      );
    }

    match /cups/{cupId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /tournament_records/{recordId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /adminData/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /supportRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update: if isAdmin();
    }

    match /seasons/{seasonId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /fcmTokens/{tokenId} {
      allow read, write: if request.auth != null;
    }

    match /bets/{betId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /tournamentSignups/{signupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /giveaways/{giveawayId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /challengeSubmissions/{submissionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /disputes/{disputeId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /openLeagueDuos/{duoId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /openLeagueSingles/{singlesId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    match /highlights/{highlightId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
    }

    match /practiceSessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /progressLogs/{logId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || resource.data.isPublic == true || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }

    match /practiceLeaderboard/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    match /liveGames/{gameId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /gameInvites/{inviteId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
