rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() in [
          'rhyshowe2023@outlook.com',
          'dhineberry@yahoo.com',
          'test@elitearrows.co.uk'
        ]) ||
        (exists(/databases/(default)/documents/users/$(request.auth.uid)) && (
          get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isTournamentAdmin', false) == true ||
          get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isCupAdmin', false) == true
        ))
      );
    }

    match /highlights/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /results/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn();
    }

    match /chat/{fileName} {
      allow read, write: if signedIn();
    }

    match /results-proof/{resultId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn();
    }
  }
}
