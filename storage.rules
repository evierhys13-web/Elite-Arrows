rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() in [
          'rhyshowe2023@outlook.com',
          'dhineberry@yahoo.com',
          'test@elitearrows.co.uk'
        ]) ||
        (exists(/databases/(default)/documents/users/$(request.auth.uid)) && (
          get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true ||
          get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isTournamentAdmin', false) == true ||
          get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isCupAdmin', false) == true
        ))
      );
    }

    match /highlights/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /gears/{userId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /results/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn();
    }

    match /chat/{fileName} {
      allow read, write: if signedIn();
    }

    match /results-proof/{resultId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn();
    }

    match /page-backgrounds/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Daily challenge submission videos.
    match /dailyChallengeSubmissions/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Weekly challenge images and player submission videos.
    match /challenges/{fileName} {
      allow read: if signedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /challengeSubmissions/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Season-pass and training payment proof photos. Scoped to the owner's
    // folder so other members cannot browse payment documents.
    match /payments/{userId}/{fileName} {
      allow read: if signedIn() && (isOwner(userId) || isAdmin());
      allow create: if signedIn() && (isOwner(userId) || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /training-payments/{userId}/{fileName} {
      allow read: if signedIn() && (isOwner(userId) || isAdmin());
      allow create: if signedIn() && (isOwner(userId) || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
