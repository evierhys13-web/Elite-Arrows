# Discord bot token (discord.com/developers -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=put_your_bot_token_here

# Your league server's ID (Discord -> Settings -> Advanced -> Developer Mode -> right-click server -> Copy Server ID)
GUILD_ID=put_your_server_id_here

# Firebase - project id, exactly as in the app (elitearrowsapp)
FIREBASE_PROJECT_ID=elitearrowsapp

# Service account - pick ONE of these three options:
# 1) Path to the JSON file downloaded from Firebase console (Project settings -> Service accounts -> Generate new private key)
FIREBASE_SERVICE_ACCOUNT=./service-account.json

# 2) OR the full JSON as a single line (useful on Render where you paste it into the dashboard)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# 3) OR set GOOGLE_APPLICATION_CREDENTIALS to the JSON path
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Optional: HTTP port for the keep-alive health endpoint (Render uses this; harmless locally)
PORT=8080